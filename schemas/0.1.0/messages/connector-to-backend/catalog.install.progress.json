{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monsterterminal.com/schemas/connector/0.1.0/messages/connector-to-backend/catalog.install.progress.json",
  "title": "catalog.install.progress",
  "description": "Avanzamento di un'installazione dal catalogo (§1.9)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "catalog.install.progress"
    },
    "id": {
      "$ref": "../../common.json#/$defs/uuid"
    },
    "re": {
      "$ref": "../../common.json#/$defs/uuid"
    },
    "ts": {
      "$ref": "../../common.json#/$defs/timestamp"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "installId": {
          "$ref": "../../common.json#/$defs/uuid"
        },
        "step": {
          "type": "integer",
          "minimum": 1
        },
        "of": {
          "type": "integer",
          "minimum": 1
        },
        "message": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [
        "installId",
        "step",
        "of",
        "message"
      ]
    }
  },
  "required": [
    "type",
    "id",
    "ts",
    "body"
  ]
}
