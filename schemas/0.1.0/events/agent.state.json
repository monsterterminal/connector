{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monsterterminal.com/schemas/connector/0.1.0/events/agent.state.json",
  "title": "agent.state",
  "description": "Stato di un agente in una sessione (§1.8). Schema del campo data del messaggio event.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "session": {
      "$ref": "../common.json#/$defs/sessionName"
    },
    "agent": {
      "$ref": "../common.json#/$defs/agentId"
    },
    "state": {
      "$ref": "../common.json#/$defs/agentState"
    },
    "source": {
      "enum": [
        "hook",
        "output-pattern",
        "idle-timer"
      ]
    }
  },
  "required": [
    "session",
    "agent",
    "state",
    "source"
  ]
}
