{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monsterterminal.com/schemas/connector/0.8.0/messages/connector-to-backend/session.zoom.result.json",
  "title": "session.zoom.result",
  "description": "Stato dello zoom dopo la richiesta; con un solo pane on è false e panes è 1 (ADR 0409 A1.2, schemi 0.6.0)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "session.zoom.result"
    },
    "id": {
      "$ref": "../../common.json#/$defs/uuid"
    },
    "re": {
      "$ref": "../../common.json#/$defs/uuid"
    },
    "ts": {
      "$ref": "../../common.json#/$defs/timestamp"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session": {
          "$ref": "../../common.json#/$defs/sessionName"
        },
        "on": {
          "type": "boolean"
        },
        "panes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "session",
        "on"
      ]
    }
  },
  "required": [
    "type",
    "id",
    "ts",
    "body",
    "re"
  ]
}
