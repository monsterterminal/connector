{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monsterterminal.com/schemas/connector/0.3.0/messages/backend-to-connector/session.config.json",
  "title": "session.config",
  "description": "Soglia di inattività di una sessione (ADR 0410 D3) (§1.6)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "session.config"
    },
    "id": {
      "$ref": "../../common.json#/$defs/uuid"
    },
    "re": {
      "$ref": "../../common.json#/$defs/uuid"
    },
    "ts": {
      "$ref": "../../common.json#/$defs/timestamp"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session": {
          "$ref": "../../common.json#/$defs/sessionName"
        },
        "idleThresholdSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        }
      },
      "required": [
        "session",
        "idleThresholdSeconds"
      ]
    }
  },
  "required": [
    "type",
    "id",
    "ts",
    "body"
  ]
}
