{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monsterterminal.com/schemas/connector/0.3.0/messages/backend-to-connector/request.respond.json",
  "title": "request.respond",
  "description": "Risposta di un utente a una richiesta dell'agente (§2.9 punto 3)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "request.respond"
    },
    "id": {
      "$ref": "../../common.json#/$defs/uuid"
    },
    "re": {
      "$ref": "../../common.json#/$defs/uuid"
    },
    "ts": {
      "$ref": "../../common.json#/$defs/timestamp"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "$ref": "../../common.json#/$defs/uuid"
        },
        "answer": {
          "enum": [
            "approva",
            "nega",
            "testo"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      },
      "required": [
        "requestId",
        "answer"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "answer": {
                "const": "testo"
              }
            }
          },
          "then": {
            "required": [
              "text"
            ]
          },
          "else": {
            "not": {
              "required": [
                "text"
              ]
            }
          }
        }
      ]
    }
  },
  "required": [
    "type",
    "id",
    "ts",
    "body"
  ]
}
