{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monsterterminal.com/schemas/connector/0.3.0/events/connector.restarted.json",
  "title": "connector.restarted",
  "description": "Connettore riavviato (§1.8). Schema del campo data del messaggio event.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "previousVersion": {
      "$ref": "../common.json#/$defs/semver"
    },
    "version": {
      "$ref": "../common.json#/$defs/semver"
    },
    "reason": {
      "enum": [
        "update",
        "rollback",
        "host-reboot",
        "service-restart",
        "crash"
      ]
    }
  },
  "required": [
    "previousVersion",
    "version",
    "reason"
  ]
}
