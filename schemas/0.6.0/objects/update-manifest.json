{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monsterterminal.com/schemas/connector/0.6.0/objects/update-manifest.json",
  "title": "Manifest di aggiornamento",
  "description": "Firmato con la chiave degli aggiornamenti sulla forma canonica (§1.10).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "$ref": "../common.json#/$defs/semver"
    },
    "os": {
      "$ref": "../common.json#/$defs/os"
    },
    "arch": {
      "$ref": "../common.json#/$defs/arch"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "minProtocol": {
      "$ref": "../common.json#/$defs/protocol"
    }
  },
  "required": [
    "version",
    "os",
    "arch",
    "url",
    "sha256",
    "minProtocol"
  ]
}
