{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monsterterminal.com/schemas/connector/0.2.0/messages/connector-to-backend/request.context.json",
  "title": "request.context",
  "description": "Contesto di una richiesta dell'agente, fuori dal giornale (§2.9 punto 2)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "request.context"
    },
    "id": {
      "$ref": "../../common.json#/$defs/uuid"
    },
    "re": {
      "$ref": "../../common.json#/$defs/uuid"
    },
    "ts": {
      "$ref": "../../common.json#/$defs/timestamp"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "$ref": "../../common.json#/$defs/uuid"
        },
        "session": {
          "$ref": "../../common.json#/$defs/sessionName"
        },
        "agent": {
          "$ref": "../../common.json#/$defs/agentId"
        },
        "kind": {
          "enum": [
            "permesso",
            "domanda"
          ]
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "detail": {
          "type": "string",
          "maxLength": 16384
        }
      },
      "required": [
        "requestId",
        "session",
        "agent",
        "kind",
        "action",
        "detail"
      ]
    }
  },
  "required": [
    "type",
    "id",
    "ts",
    "body"
  ]
}
