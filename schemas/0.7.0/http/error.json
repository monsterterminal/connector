{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monsterterminal.com/schemas/connector/0.7.0/http/error.json",
  "title": "Corpo di un errore HTTP",
  "description": "Errori di /v1/register e del rifiuto all'upgrade (§1.3, §1.4). Dalla 0.4.0 anche BILLING_REQUIRED, HTTP 402 e chiusura 4402 (ADR 0418 D5, §3.13).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "code": {
      "enum": [
        "INSTALL_TOKEN_INVALID",
        "BODY_INVALID",
        "SERVER_LIMIT",
        "CONNECTOR_TOO_OLD",
        "HOST_TOKEN_INVALID",
        "HOST_REVOKED",
        "HOST_DISABLED",
        "BILLING_REQUIRED",
        "RATE_LIMITED",
        "UNAVAILABLE"
      ]
    }
  },
  "required": [
    "code"
  ]
}
