{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monsterterminal.com/schemas/connector/0.7.0/messages/connector-to-backend/session.buffer.result.json",
  "title": "session.buffer.result",
  "description": "Testo dell'ultimo paste-buffer creato da al più 15 secondi, altrimenti null; al più 64 KiB in UTF-8 (ADR 0409 A1.2, schemi 0.6.0)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "session.buffer.result"
    },
    "id": {
      "$ref": "../../common.json#/$defs/uuid"
    },
    "re": {
      "$ref": "../../common.json#/$defs/uuid"
    },
    "ts": {
      "$ref": "../../common.json#/$defs/timestamp"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "channel": {
          "$ref": "../../common.json#/$defs/channel"
        },
        "text": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 65536
        }
      },
      "required": [
        "channel",
        "text"
      ]
    }
  },
  "required": [
    "type",
    "id",
    "ts",
    "body",
    "re"
  ]
}
