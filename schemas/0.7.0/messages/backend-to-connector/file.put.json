{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monsterterminal.com/schemas/connector/0.7.0/messages/backend-to-connector/file.put.json",
  "title": "file.put",
  "description": "Un blocco di un file verso la home dell'utente di servizio: blocchi in sequenza, uno alla volta; il primo apre il trasferimento, l'ultimo verifica sha256 e rinomina. Nessuna esecuzione (ADR 0409 A1.5, schemi 0.7.0)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "file.put"
    },
    "id": {
      "$ref": "../../common.json#/$defs/uuid"
    },
    "re": {
      "$ref": "../../common.json#/$defs/uuid"
    },
    "ts": {
      "$ref": "../../common.json#/$defs/timestamp"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transferId": {
          "$ref": "../../common.json#/$defs/uuid"
        },
        "path": {
          "$ref": "../../common.json#/$defs/homePath"
        },
        "filename": {
          "$ref": "../../common.json#/$defs/fileName"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 52428800
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "overwrite": {
          "type": "boolean"
        },
        "chunkIndex": {
          "type": "integer",
          "minimum": 0
        },
        "totalChunks": {
          "type": "integer",
          "minimum": 1
        },
        "data": {
          "type": "string",
          "maxLength": 262144,
          "pattern": "^[A-Za-z0-9+/]*={0,2}$",
          "contentEncoding": "base64"
        }
      },
      "required": [
        "transferId",
        "path",
        "filename",
        "size",
        "sha256",
        "chunkIndex",
        "totalChunks",
        "data"
      ]
    }
  },
  "required": [
    "type",
    "id",
    "ts",
    "body"
  ]
}
