{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monsterterminal.com/schemas/connector/0.9.0/messages/backend-to-connector/session.open.json",
  "title": "session.open",
  "description": "Apertura di un canale su una sessione tmux (§1.7). Dalla 0.6.0 fitToPane: il canale nasce con le dimensioni della finestra tmux (ADR 0409 A1.2). Dalla 0.9.0 fitRows \"client\", solo con fitToPane: colonne della finestra e righe del client (almeno 5), con il client tmux agganciato in ignore-size, che non cambia mai la finestra per gli altri client (ADR 0409 A1.6)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "session.open"
    },
    "id": {
      "$ref": "../../common.json#/$defs/uuid"
    },
    "re": {
      "$ref": "../../common.json#/$defs/uuid"
    },
    "ts": {
      "$ref": "../../common.json#/$defs/timestamp"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "channel": {
          "$ref": "../../common.json#/$defs/channel"
        },
        "session": {
          "$ref": "../../common.json#/$defs/sessionName"
        },
        "create": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "view",
            "interact"
          ]
        },
        "cols": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "fitToPane": {
          "type": "boolean"
        },
        "fitRows": {
          "enum": [
            "client"
          ],
          "description": "righe del client (le righe visibili del dispositivo) al posto di quelle della finestra; il client tmux non conta per la dimensione della finestra finché ci sono altri client. Con tmux < 3.2 il connettore ripiega su fitToPane e non lo dichiara in session.opened"
        }
      },
      "required": [
        "channel",
        "session",
        "create",
        "mode",
        "cols",
        "rows"
      ],
      "if": {
        "required": [
          "fitRows"
        ]
      },
      "then": {
        "required": [
          "fitToPane"
        ],
        "properties": {
          "fitToPane": {
            "const": true
          },
          "rows": {
            "minimum": 5
          }
        }
      }
    }
  },
  "required": [
    "type",
    "id",
    "ts",
    "body"
  ]
}
